[Unit]
Description=Hermes Skill Proxy — auto-inject skill into system prompt
After=network.target hermes-gateway.service
Wants=hermes-gateway.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@PROXY_DIR@
Environment="PROXY_PORT=8643"
Environment="HERMES_URL=http://localhost:8642"
Environment="HERMES_API_KEY=hermes-website-search"
Environment="SKILL_NAME=inexbot-knowledge-base"

ExecStart=/usr/bin/python3 @PROXY_DIR@/hermes-skill-proxy.py
Restart=always
RestartSec=5

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-skill-proxy

[Install]
WantedBy=multi-user.target
